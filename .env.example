# ==============================================================================
# Portfolio Platform — Environment Configuration Template
# For Render deployment, configure these in Render Dashboard > Environment.
# For local development, copy this file to .env and adjust as needed.
# ==============================================================================

# Server Network Configuration
PORT=5050
HOST=0.0.0.0
NODE_ENV=development

# Persistent Storage Directory
# In Render Web Service with a Persistent Disk attached, set to /var/data.
# Student data and portfolios will be written to ${DATA_DIR}/portfolio-data.json.
# NOTE: Render containers have ephemeral storage. A Persistent Disk MUST be mounted at /var/data.
DATA_DIR=data

# Platform Administrator Authentication
# Required in production. Minimum 8 characters for password.
ADMIN_USERNAME=admin_1234
ADMIN_PASSWORD=replace_with_secure_admin_password_min_8_chars

# Session Encryption Secret
# Must be at least 32 characters in production (e.g. generated via `openssl rand -hex 32`).
SESSION_SECRET=replace_with_64_character_cryptographically_secure_random_hex_secret

# Session Duration in Hours (defaults to 24)
SESSION_TTL_HOURS=24
